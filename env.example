# 环境变量示例（把本文件内容复制到项目根目录的 .env 或 .env.local 再填真实值）
# ⚠️ 不要把真实密钥/密码提交到仓库；如曾经入库请立即轮换并清理 Git 历史

# =========================
# 后端服务
# =========================
PORT=3001
JSON_LIMIT=1mb
# 多个来源用逗号分隔；生产环境请把你的 https 域名也加上（否则可能被 CORS 拦截）
CORS_ORIGINS=http://localhost:5173,https://your-domain.com

# =========================
# PostgreSQL（推荐使用 DATABASE_URL；否则使用下方参数）
# =========================
# DATABASE_URL=postgres://user:password@host:5432/Softwares
PGHOST=localhost
PGPORT=5432
PGDATABASE=Softwares
PGUSER=postgres
PGPASSWORD=
PGSSL=false

# 连接池（可选）
PGPOOL_MAX=20
PG_IDLE_TIMEOUT=30000
PG_CONN_TIMEOUT=5000

# =========================
# 腾讯云 COS
# =========================
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-guangzhou
COS_STORAGE_PATH=AppArchive/
COS_DOMAIN=https://<bucket>.cos.<region>.myqcloud.com

# =========================
# AI 配置说明
# =========================
# AI 供应商和 API Key 不再通过环境变量配置
# 请启动应用后在「设置 → AI 设置」中配置
# 支持: Perplexity / OpenAI / Moonshot(Kimi) / DeepSeek / 自定义(OpenAI兼容)

# =========================
# 认证（自建 JWT）
# =========================
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRES_IN=7d
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# 用于加密敏感字段（secrets 等）
APP_SECRET_KEY=dev-secret-key

# =========================
# GitHub API（可选）
# =========================
# 配置 Personal Access Token 后 API 限额从 60→5000 次/小时
# 生成地址: https://github.com/settings/tokens（只需 public_repo 权限）
GITHUB_TOKEN=
# 缓存时长（秒），默认 6 小时
GITHUB_CACHE_TTL=21600

# =========================
# 前端
# =========================
# 生产环境（HTTPS）推荐使用同源 /api（需在反向代理中把 /api 转发到后端 3001）
VITE_API_BASE_URL=/api


