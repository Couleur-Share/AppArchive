# 环境变量示例（把本文件内容复制到项目根目录的 .env 或 .env.local 再填真实值）
# ⚠️ 不要把真实密钥/密码提交到仓库；如曾经入库请立即轮换并清理 Git 历史

# =========================
# 后端服务
# =========================
PORT=3001
JSON_LIMIT=1mb
# 多个来源用逗号分隔；生产环境请把你的 https 域名也加上（否则可能被 CORS 拦截）
CORS_ORIGINS=http://localhost:5173,https://your-domain.com

# =========================
# PostgreSQL（推荐使用 DATABASE_URL；否则使用下方参数）
# =========================
# DATABASE_URL=postgres://user:password@host:5432/Softwares
PGHOST=localhost
PGPORT=5432
PGDATABASE=Softwares
PGUSER=postgres
PGPASSWORD=
PGSSL=false

# 连接池（可选）
PGPOOL_MAX=20
PG_IDLE_TIMEOUT=30000
PG_CONN_TIMEOUT=5000

# =========================
# 腾讯云 COS
# =========================
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-guangzhou
COS_STORAGE_PATH=AppArchive/
COS_DOMAIN=https://<bucket>.cos.<region>.myqcloud.com

# =========================
# AI
# =========================
KIMI_API_KEY=
KIMI_API_BASE=https://api.moonshot.cn/v1

# =========================
# 认证 & 前端
# =========================
VITE_CLERK_PUBLISHABLE_KEY=
# 生产环境（HTTPS）推荐使用同源 /api（需在反向代理中把 /api 转发到后端 3001）
VITE_API_BASE_URL=/api


